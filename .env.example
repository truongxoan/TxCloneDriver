# DataVault Cloud Hub — Environment Configuration
# Mẫu biến môi trường phục vụ cấu hình server & hạ tầng

# --- Core App Settings ---
NEXT_PUBLIC_APP_NAME="DataVault Cloud Hub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"

# --- Database & Storage (Giai đoạn 2) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/datavault?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/datavault?schema=public"

# --- Authentication & Session Security (Giai đoạn 2) ---
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Drive API v3 (Giai đoạn 3) ---
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_DRIVE_REFRESH_TOKEN=""

# --- Weather API (Giai đoạn 5) ---
OPENWEATHER_API_KEY=""
WEATHER_API_BASE_URL="https://api.openweathermap.org/data/2.5"
WEATHER_CACHE_TTL_SECONDS=1800

# --- Telegram Bot API (Giai đoạn 6) ---
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_WEBHOOK_SECRET="your-secure-telegram-webhook-secret-string"
TELEGRAM_ALLOWED_USER_IDS="12345678,87654321"

# --- Backup & Automation (Giai đoạn 7) ---
BACKUP_LOCAL_DIR="./storage/backups"
BACKUP_ENCRYPTION_KEY="your-aes-256-encryption-key"
